# Generate an unpredictable value of at least 50 characters. The placeholder
# below is intentionally rejected by production settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0

# The shipped Compose port is direct loopback HTTP. These defaults keep login
# sessions usable at http://127.0.0.1:8000/. See README.md before exposing the
# service through an external TLS proxy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
TWITCH_FARM_PORT=8000

# Match the local owner of config.yaml, data/, cookies/, and runtime/ while keeping all
# container processes non-root. Get these values with: id -u; id -g
PUID=1000
PGID=1000
