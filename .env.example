# Generate an unpredictable value of at least 50 characters. The placeholder
# below is intentionally rejected by production settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# One or more comma-separated Fernet keys. Generate one with the command in
# README.md. The first key encrypts new data; every listed key can decrypt.
TWITCH_FARM_CREDENTIAL_KEYS=replace-with-a-generated-fernet-key
DJANGO_DEBUG=0

# The shipped Compose port is direct loopback HTTP. These defaults keep login
# sessions usable at http://127.0.0.1:8000/. See README.md before exposing the
# service through an external TLS proxy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
TWITCH_FARM_PORT=8000
# Upper bound for a Twitch device-login handshake. Twitch codes normally live
# for 30 minutes; keep this slightly above the exact expiry returned by Twitch.
MINER_AUTHENTICATION_HANDSHAKE_SECONDS=1900

# Match the local owner of data/ and runtime/ while keeping all container
# processes non-root. Get these values with: id -u; id -g
PUID=1000
PGID=1000
