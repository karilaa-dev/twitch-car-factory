# Telegram Bot Configuration
telegram:
  bot_token: "YOUR_BOT_TOKEN_HERE"
  # Telegram user IDs allowed to use this bot
  whitelist:
    - 123456789  # Replace with your Telegram user ID

# Bot Settings
settings:
  # Automatically start all instances when bot starts
  autostart_instances: false

# Twitch Users Configuration
# Add users manually here - they cannot be added via bot
twitch_users:
  karilaa_exe:
    username: "karilaa-dev"
    password: "YOUR_PASSWORD_HERE"

  # Example of another user:
  # another_user:
  #   username: "another_user"
  #   password: "password_here"

# Default channels to farm if no preset is assigned
default_channels:
  - "warframe"
  - "twitch"
