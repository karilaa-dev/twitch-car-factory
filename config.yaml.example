# Process configuration remains file-backed and read-only to the web panel.
settings:
  # Seeds newly discovered accounts as desired-running. A later admin stop is durable.
  autostart_instances: false

# Accounts are edited here, not in Django. The worker reloads this file before launches.
twitch_users:
  primary:
    username: "your_twitch_username"
    password: "YOUR_PASSWORD_HERE"

# Used whenever an account selects the Default channel source.
default_channels:
  - "channel_one"
  - "channel_two"
